# =============================================================================
# CampusPilot AI — Root Docker Compose Environment Configuration
# Copy this file to .env before building or launching Docker Compose:
#   cp .env.example .env
#
# Replace all placeholder values with your verified production credentials.
# NEVER commit the active .env file to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
APP_NAME=CampusPilot AI
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security: Allowed CORS origins and hostnames (comma-separated or JSON list)
# Configured for the live production frontend at https://campuspilotai.vercel.app
CORS_ORIGINS=https://campuspilotai.vercel.app
ALLOWED_HOSTS=YOUR_EC2_HOSTNAME_OR_IP,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# 2. GOOGLE GEMINI API (Required for RAG Orchestrator & Multi-Turn Chat)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# -----------------------------------------------------------------------------
# 3. SUPABASE MANAGED DATABASE & AUTHENTICATION
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional: Direct PostgreSQL Connection String for pgvector direct queries
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>



# -----------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay) — DEFERRED
# Do not activate or configure real credentials during this deployment phase.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 5. BUSINESS RULES & SYSTEM PARAMETERS
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin@campuspilot.ai,administrator@campuspilot.ai
MAX_UPLOAD_SIZE_BYTES=10485760
VISITOR_CHAT_LIMIT=3
INITIAL_FREE_CREDITS=20
LOW_CREDIT_THRESHOLD=5
IDEMPOTENCY_STALE_TIMEOUT_SECONDS=60
IDEMPOTENCY_HEARTBEAT_INTERVAL_SECONDS=15.0
